# Local overrides. Copy to .env.development.local, NOT .env.local.
#
# Vite loads .env.local in every mode, production builds included, and it wins
# over .env.production. A local override left in .env.local therefore ends up
# baked into the deployed bundle: that is how http://staging...:7350 reached
# production, where the browser blocked it as mixed content and the stats pill
# silently fell back to its snapshot. .env.development.local only loads for
# `npm run dev`, so it cannot leak into a build.
#
# Nothing here is required. The code defaults are the production values:
#   stats  -> https://staging.geofastgames.com   (public_stats is not on prod)
#   nakama -> https://nakamacdn.geofastgames.com (reset tokens live in prod)
# Both use the client-shipped http_key, which is public by design.

# Stats (live numbers on the landing page)
VITE_STATS_SERVER_URL=http://staging.geofastgames.com:7350
VITE_STATS_SERVER_KEY=your_http_key_here

# Nakama (reset-password page). Point at staging while developing so local
# testing never touches prod accounts.
VITE_NAKAMA_SERVER_URL=http://staging.geofastgames.com:7350
VITE_NAKAMA_SERVER_KEY=your_http_key_here
